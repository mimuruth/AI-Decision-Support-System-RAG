# OpenAI API Key (required for LLM generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Embedding model (default: all-MiniLM-L6-v2, runs locally without API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: ChromaDB persistence directory (default: ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# Optional: Collection name for vector store (default: rag_documents)
COLLECTION_NAME=rag_documents
